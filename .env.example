# MyFitnessPal Credentials
# 如果由于 CAPTCHA 无法直接登录，代码会自动尝试从浏览器（Chrome/Firefox 等）读取 Cookie
MFP_USERNAME=your_username
MFP_PASSWORD=your_password

# 如果需要手动指定 Cookie（高级用法）
# MFP_COOKIES=

# USDA FoodData Central API Key (免费申请: https://fdc.nal.usda.gov/api-key-signup/)
# 不配置则使用 DEMO_KEY（限速较低）
USDA_API_KEY=your_usda_api_key_here
